{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env src/db/migrate.ts down",
    "db:status": "node --env-file-if-exists=.env src/db/migrate.ts status",
    "db:types": "node src/db/generate-types.ts",
    "openapi:generate": "node --env-file-if-exists=.env src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@repo/contracts": "workspace:*",
    "better-auth": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "imapflow": "catalog:",
    "kysely": "catalog:",
    "mailparser": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "unpdf": "^2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/mailparser": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kysely-typegen": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
