NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
DATABASE_POOL_MAX=10

# Authentication. Generate the secret with: openssl rand -base64 32
# Never reuse or commit a real secret.
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Set to 1 when behind one reverse proxy, or to a CIDR/loopback value.
# Never use "true" in a deployment where clients can reach the API directly.
TRUST_PROXY=false

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=30

# Optional: run the same migration tests against a real PostgreSQL 19 database.
# The database name must end in _test.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test

# OpenRouter (chat + vision analysis). Get a key at https://openrouter.ai/keys
# Never commit a real key.
OPENROUTER_API_KEY=replace-me-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
AI_TIMEOUT_MS=120000

# Local bge-m3 embeddings (transformers.js). The model downloads on first use
# into EMBEDDING_CACHE_DIR (relative to the API working directory).
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_CACHE_DIR=.models

# Document ingestion limits.
DOCUMENT_MAX_BYTES=15728640
